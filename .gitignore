# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Local editor settings can hold machine paths (SDK, devices): keep them out.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release signing material: never commit
android/key.properties
**/*.jks
**/*.keystore

# Secrets and machine-local configuration: never commit. API keys are typed
# only on the phone and kept in its secure storage (D38).
.env
.env.*
*.env.json
dart_defines*.json
**/key.properties
**/local.properties
*.p12
*.p8
*.pem
*.mobileprovision
google-services.json
GoogleService-Info.plist

# Personal data the app exports (backups, safety copies) and database files
forja-respaldo-*.json
forja-previo-*.json
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Build outputs and dumps
*.apk
*.aab
*.ipa
*.hprof
*.tmp

# Local agent tooling
.claude/
