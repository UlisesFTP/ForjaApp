<?xml version="1.0" encoding="utf-8"?>
<!-- Splash while Flutter starts: the FORJA mark centered on the app's dark
     background, so there is no white or black flash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/forja_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
