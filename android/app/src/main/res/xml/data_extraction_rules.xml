<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of FORJA goes into cloud backups or device-to-device
     transfers (on some phones allowBackup="false" alone does not stop the
     transfer). The person's own export is the backup (F13); the assistant's
     key stays on this phone only (D38). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
